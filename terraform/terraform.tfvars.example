region             = "ap-south-1"
platform           = "platform"
environment        = "assignment"
instance_type      = "t3.micro"
docker_image           = "ghcr.io/bh-an/ec2-go-service@sha256:<digest>"
ami_ssm_parameter_name = "/sc/ec2-go-service/dev/ami-id"
root_volume_size_gib   = 30
